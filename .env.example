# Neon Postgres — tables AND auth (Better Auth stores identities in auth_* tables).
# Pooled endpoint (host contains "-pooler") for the app; direct endpoint for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"
# Optional: per-instance pg pool size (default 5)
# DATABASE_POOL_MAX="5"
# Local Postgres / CI only:
# DATABASE_SSL="false"

# Better Auth (self-hosted; sessions use __Host-akura.* cookies)
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Dev only — ignored in production. Skip the email verification step locally.
# AUTH_SKIP_EMAIL_VERIFICATION="true"

# Single config for the public site host (not used as a cookie Domain)
APP_BASE_DOMAIN="akura.elgiriya.com"

# Resend (Phase 8 email)
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Akura <noreply@your-verified-domain.com>"
# Optional — protect cron + Resend webhook in production
CRON_SECRET="long-random-string"
RESEND_WEBHOOK_SECRET="long-random-string"

# PayHere (Phase 9)
PAYHERE_MERCHANT_ID="your-merchant-id"
PAYHERE_MERCHANT_SECRET="your-merchant-secret"
# Set to "false" for live; default sandbox
PAYHERE_SANDBOX="true"
BANK_OPS_SECRET="long-random-string"
BANK_TRANSFER_BANK_NAME="Commercial Bank of Ceylon"
BANK_TRANSFER_ACCOUNT_NAME="Elgiriya Innovations"
BANK_TRANSFER_ACCOUNT_NUMBER="1234567890"
BANK_TRANSFER_BRANCH="Colombo"

# Supabase Storage only (no Supabase Auth/DB). Server-side key — never expose to the browser.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="akura-uploads"
